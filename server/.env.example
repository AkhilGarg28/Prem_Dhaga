# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development           # development | production

# ─── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/prem_dhaga
# Production: use MongoDB Atlas connection string
# MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/prem_dhaga?retryWrites=true&w=majority

# ─── Redis ────────────────────────────────────────────────────────────────────
# Optional in development — server starts without it (in-memory fallbacks activate).
# Required in production for cart persistence, sessions, and rate limiting.
# REDIS_URL=redis://localhost:6379
# REDIS_URL=rediss://<user>:<password>@<host>:<port>   # TLS (Redis Cloud, Upstash)

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
JWT_EXPIRY=15m                 # access token lifetime
JWT_REFRESH_EXPIRY=30d         # refresh token lifetime
ADMIN_SECRET=REPLACE_WITH_ADMIN_BOOTSTRAP_SECRET

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash).
# Leave blank in development — localhost variants are auto-allowed.
# ALLOWED_ORIGINS=https://premdhaga.com,https://www.premdhaga.com

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ─── Cloudinary (Media) ───────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=prem_dhaga_unsigned  # for unsigned client-side uploads

# ─── Razorpay (Payments) ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── Resend (Transactional Email) ─────────────────────────────────────────────
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXX
RESEND_FROM_EMAIL=seva@premdhaga.com
RESEND_FROM_NAME=Prem Dhaga

# ─── SMS / OTP ────────────────────────────────────────────────────────────────
# Choose one OTP provider. Examples:
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_SENDER_ID=PREMDA

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info                 # error | warn | info | http | debug

# ─── Error Monitoring (Sentry) ────────────────────────────────────────────────
# SENTRY_DSN=https://xxxxx@oxxxx.ingest.sentry.io/xxxxx

# ─── Shipping (Phase 3 — mock until courier API is chosen) ───────────────────
# SHIPROCKET_EMAIL=your_shiprocket_email
# SHIPROCKET_PASSWORD=your_shiprocket_password
# DELHIVERY_TOKEN=your_delhivery_api_token
